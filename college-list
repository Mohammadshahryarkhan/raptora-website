     JAVASCRIPT
========================================= -->

<script>

(function () {

    const search =
        document.getElementById("collegeSearch");

    const location =
        document.getElementById("collegeLocation");

    const cards =
        document.querySelectorAll(
            ".raptora-college-card"
        );

    const noResults =
        document.getElementById(
            "collegeNoResults"
        );


    function filterColleges() {

        const query =
            search.value
                .toLowerCase()
                .trim();

        const selectedLocation =
            location.value;

        let count = 0;


        cards.forEach(function (card) {

            const name =
                card.dataset.name
                    .toLowerCase();

            const cardLocation =
                card.dataset.location;


            const searchMatch =
                name.includes(query);

            const locationMatch =
                selectedLocation === "all" ||
                cardLocation === selectedLocation;


            if (
                searchMatch &&
                locationMatch
            ) {

                card.style.display = "";
                count++;

            } else {

                card.style.display = "none";

            }

        });


        noResults.style.display =
            count === 0
                ? "block"
                : "none";

    }


    search.addEventListener(
        "input",
        filterColleges
    );

    location.addEventListener(
        "change",
        filterColleges
    );

})();



/* Open Poster */

function raptoraOpenPoster(image) {

    const modal =
        document.getElementById(
            "raptoraPosterModal"
        );

    const modalImage =
        document.getElementById(
            "raptoraModalImage"
        );


    modalImage.src = image;

    modal.classList.add("active");

    document.body.style.overflow =
        "hidden";
}



/* Close Poster */

function raptoraClosePoster() {

    document
        .getElementById(
            "raptoraPosterModal"
        )
        .classList.remove("active");

    document.body.style.overflow = "";

}



/* Click Outside */

document
    .getElementById("raptoraPosterModal")
    .addEventListener(
        "click",
        function (event) {

            if (event.target === this) {
                raptoraClosePoster();
            }

        }
    );



/* ESC */

document.addEventListener(
    "keydown",
    function (event) {

        if (event.key === "Escape") {
            raptoraClosePoster();
        }

    }
);

</script>